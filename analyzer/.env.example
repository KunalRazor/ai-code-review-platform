# Analyzer service configuration.
# Defaults run fully offline (no keys, no DB). Override to go real.

# hash (offline, default) | local (sentence-transformers) | openai
EMBEDDINGS_PROVIDER=hash
EMBEDDING_DIM=256

# mock (offline, default) | anthropic | openai
LLM_PROVIDER=mock
LLM_MODEL=claude-opus-4-6

# Set to enable pgvector-backed RAG. Leave unset to use the in-memory store.
# DATABASE_URL=postgres://acr:acr@127.0.0.1:5432/acr

# Only needed for real providers:
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx

RAG_TOP_K=3
