# Copy to .env and fill in the values.
# Load into your shell with:  export $(grep -v '^#' .env | xargs)

PORT=8080

# Shared secret. Set the SAME value in the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=change-me

# GitHub token. Fine-grained token needs:
#   - Pull requests: Read and write   (to post comments)
#   - Contents:      Read-only         (to read the diff)
GITHUB_TOKEN=github_pat_xxx

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional. Defaults to claude-opus-4-6.
# Use claude-haiku-4-5 for a cheaper/faster review.
LLM_MODEL=claude-opus-4-6
